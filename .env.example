DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_AI_BASE_URL=http://localhost:11434/v1
INBOUND_WEBHOOK_SECRET=
CRON_SECRET=
HOLD_MINUTES=10
# Required for test:integration. A separate Neon branch (direct, unpooled string). Never the dev database.
TEST_DATABASE_URL=
# Comma separated host fragments that seed, reset and the tests refuse to touch (e.g. production).
DB_PROTECTED_HOSTS=
# Enables the hidden /dev area (UI kit, inbound simulator). Anything but "true" means 404. Never on in production.
DEV_TOOLS_ENABLED=false
